{
	"name": "kylin-debug",
	"displayName": "Kylin Native Debug",
	"description": "Fork of Native Debug, with bug fixes and primarily tested using gdb",
	"keywords": [
		"KylinIdeDev",
		"KylinIdeDevDebug",
		"KylinIdeDevCYuYan",
		"KylinIdeDevCPlusPlus",
		"gdb",
		"lldb",
		"mago-mi",
		"native",
		"debug"
	],
	"license": "mit",
	"version": "0.3.0",
	"publisher": "KylinIdeTeam",
	"icon": "images/icon.png",
	"engines": {
		"vscode": "^1.54.0"
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"onDebug",
		"onCommand:code-debug.examineMemoryLocation",
		"onCommand:code-debug.getFileNameNoExt",
		"onCommand:code-debug.getFileBasenameNoExt",
		"onCommand:code-debug.startRecord",
		"onCommand:code-debug.stopRecord"
	],
	"downloadUrl": "https://gitee.com/openkylin/extensions-repo/tree/master/KylinIdeTeam/debug",
	"categories": [
		"Debuggers"
	],
	"repository": {
		"type": "git",
		"url": "https://gitee.com/openkylin/native-debug.git"
	},
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "code-debug.examineMemoryLocation",
				"title": "%commands.examineMemoryLocation%"
			},
			{
				"command": "code-debug.startRecord",
				"title": "%commands.startRecord%",
				"icon": "$(debug-start)"
			},
			{
				"command": "code-debug.stopRecord",
				"title": "%commands.stopRecord%",
				"icon": "$(debug-stop)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "code-debug.startRecord",
					"when": "code-debug.enableRecord && inDebugMode && debugState == stopped && debugType == 'gdb' && code-debug.enableStartRecord",
					"group": "navigation"
				},
				{
					"command": "code-debug.stopRecord",
					"when": "code-debug.enableRecord && inDebugMode && debugState == stopped && debugType == 'gdb' && !code-debug.enableStartRecord",
					"group": "navigation"
				}
			]
		},
		"breakpoints": [
			{
				"language": "c"
			},
			{
				"language": "cpp"
			},
			{
				"language": "d"
			},
			{
				"language": "objective-c"
			},
			{
				"language": "fortran"
			},
			{
				"language": "fortran-modern"
			},
			{
				"language": "fortran90"
			},
			{
				"language": "fortran_free-form"
			},
			{
				"language": "fortran_fixed-form"
			},
			{
				"language": "rust"
			},
			{
				"language": "pascal"
			},
			{
				"language": "objectpascal"
			},
			{
				"language": "ada"
			},
			{
				"language": "nim"
			},
			{
				"language": "arm"
			},
			{
				"language": "asm"
			},
			{
				"language": "vala"
			},
			{
				"language": "crystal"
			},
			{
				"language": "kotlin"
			},
			{
				"language": "zig"
			}
		],
		"debuggers": [
			{
				"type": "gdb",
				"program": "./dist/gdb.js",
				"runtime": "node",
				"label": "GDB",
				"languages": [
					"c",
					"cpp",
					"d",
					"objective-c",
					"fortran",
					"fortran-modern",
					"fortran90",
					"fortran_free-form",
					"fortran_fixed-form",
					"rust",
					"pascal",
					"objectpascal",
					"ada",
					"nim",
					"arm",
					"asm",
					"vala",
					"crystal",
					"kotlin",
					"zig"
				],
				"variables": {
					"FileBasenameNoExt": "code-debug.getFileBasenameNoExt",
					"FileNameNoExt": "code-debug.getFileNameNoExt"
				},
				"configurationAttributes": {
					"launch": {
						"required": [
							"target",
							"cwd"
						],
						"properties": {
							"target": {
								"type": "string",
								"description": "%launch.target%"
							},
							"arguments": {
								"type": "string",
								"description": "%launch.arguments%"
							},
							"terminal": {
								"type": "string",
								"description": "%gdb.launch.terminal%"
							},
							"cwd": {
								"type": "string",
								"description": "%cwd%"
							},
							"gdbpath": {
								"type": "string",
								"description": "%gdbpath%",
								"default": "gdb"
							},
							"env": {
								"type": "object",
								"description": "%gdb.env%",
								"default": null
							},
							"debugger_args": {
								"type": "array",
								"description": "%gdb.debugger_args%",
								"default": []
							},
							"pathSubstitutions": {
								"type": "object",
								"description": "%gdb.pathSubstitutions%",
								"default": {
									"<fromPath>": "<toPath>"
								}
							},
							"valuesFormatting": {
								"type": "string",
								"description": "%valuesFormatting%",
								"default": "parseText",
								"enum": [
									"disabled",
									"parseText",
									"prettyPrinters"
								]
							},
							"printCalls": {
								"type": "boolean",
								"description": "%gdb.printCalls%",
								"default": false
							},
							"showDevDebugOutput": {
								"type": "boolean",
								"description": "%gdb.showDevDebugOutput%",
								"default": false
							},
							"autorun": {
								"type": "array",
								"description": "%gdb.autorun%",
								"default": []
							},
							"stopAtEntry": {
								"type": [
									"boolean",
									"string"
								],
								"description": "%stopAtEntry%",
								"default": false
							},
							"ssh": {
								"required": [
									"host",
									"user",
									"cwd"
								],
								"type": "object",
								"description": "%gdb.launch.ssh%",
								"properties": {
									"host": {
										"type": "string",
										"description": "%ssh.host%"
									},
									"port": {
										"type": [
											"number",
											"string"
										],
										"description": "%ssh.port%",
										"default": 22
									},
									"user": {
										"type": "string",
										"description": "%ssh.user%"
									},
									"password": {
										"type": "string",
										"description": "%ssh.password%"
									},
									"keyfile": {
										"type": "string",
										"description": "%ssh.keyfile%"
									},
									"useAgent": {
										"type": "boolean",
										"description": "%ssh.useAgent%",
										"default": false
									},
									"sourceFileMap": {
										"type": "object",
										"description": "%ssh.sourceFileMap%",
										"default": {
											"<sourcePath>": "<localPath>"
										}
									},
									"cwd": {
										"type": "string",
										"description": "%ssh.cwd%"
									},
									"forwardX11": {
										"type": "boolean",
										"description": "%ssh.forwardX11%",
										"default": true
									},
									"x11port": {
										"type": [
											"number",
											"string"
										],
										"description": "%ssh.x11port%",
										"default": 6000
									},
									"x11host": {
										"type": "string",
										"description": "%ssh.x11host%",
										"default": "localhost"
									},
									"remotex11screen": {
										"type": "number",
										"description": "%ssh.remotex11screen%",
										"default": 0
									},
									"bootstrap": {
										"type": "string",
										"description": "%ssh.bootstrap%"
									}
								}
							}
						}
					},
					"attach": {
						"required": [
							"target",
							"cwd"
						],
