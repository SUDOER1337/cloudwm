								"default": "parseText",
								"enum": [
									"disabled",
									"parseText",
									"prettyPrinters"
								]
							},
							"printCalls": {
								"type": "boolean",
								"description": "%gdb.printCalls%",
								"default": false
							},
							"showDevDebugOutput": {
								"type": "boolean",
								"description": "%gdb.showDevDebugOutput%",
								"default": false
							},
							"executable": {
								"type": "string",
								"description": "%attach.executable%"
							},
							"gdbpath": {
								"type": "string",
								"description": "%gdbpath%",
								"default": "gdb"
							},
							"env": {
