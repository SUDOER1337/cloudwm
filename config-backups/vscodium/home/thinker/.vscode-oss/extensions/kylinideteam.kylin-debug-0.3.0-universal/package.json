											"string"
										],
										"description": "%ssh.x11port%",
										"default": 6000
									},
									"x11host": {
										"type": "string",
										"description": "%ssh.x11host%",
										"default": "localhost"
									},
									"remotex11screen": {
										"type": "number",
										"description": "%ssh.remotex11screen%",
										"default": 0
									},
									"bootstrap": {
										"type": "string",
										"description": "%ssh.bootstrap%"
									}
								}
							}
