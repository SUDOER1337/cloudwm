{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "auto",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 4
    }
  },

  "display": {
    "separator": "| ",
    "brightColor": false,
    "color": {
      "keys": "38;2;189;170;127",
      "title": "38;2;217;204;190",
      "output": "38;2;211;195;171",
      "separator": "38;2;77;74;72"
    }
  },

  "modules": [
    {
      "type": "break"
    },
    {
      "type": "break"
    },
    {
      "type": "title",
      "format": "{#38;2;89;102;30} {#38;2;168;153;132}  {user-name} {#38;2;89;102;105}──────────────────┐"
    },
    {
      "type": "custom",
      "format": "{#38;2;89;102;105}├─ {#38;2;189;170;127} System Information"
    },
    {
      "type": "os",
      "key": "{#38;2;77;74;72}│ {#38;2;199;171;138}──[  OS ",
      "keyWidth": 17
    },
    {
      "type": "kernel",
      "key": "{#38;2;77;74;72}│ {#38;2;179;120;125}──[  Kernel ",
      "format": "{release}",
      "keyWidth": 17
    },
    {
      "type": "uptime",
      "key": "{#38;2;77;74;72}│ {#38;2;177;154;166}──[  Uptime ",
      "format": "{?days}{days}d {?}{hours}h {minutes}m",
      "keyWidth": 17
    },
    {
      "type": "packages",
      "key": "{#38;2;77;74;72}│ {#38;2;152;176;140}──[ 󰏖 Pkgs ",
      "format": "{all}",
      "keyWidth": 17
    },
    {
      "type": "custom",
      "format": "{#38;2;89;102;105}├─ {#38;2;143;174;181} Desktop Environment"
    },
    {
      "type": "wm",
      "key": "{#38;2;77;74;72}│ {#38;2;143;174;181}──[  WM ",
      "keyWidth": 17
    },
    {
      "type": "display",
      "key": "{#38;2;77;74;72}│ {#38;2;138;156;170}──[  Display ",
      "format": "{width}x{height} @ {refresh-rate} Hz",
      "keyWidth": 17
    },
    {
      "type": "shell",
      "key": "{#38;2;77;74;72}│ {#38;2;176;172;175}──[  Shell ",
      "keyWidth": 17
    },
    {
      "type": "terminalfont",
      "key": "{#38;2;77;74;72}│ {#38;2;156;181;184}──[  Font ",
      "format": "{/name}{-}{/}{name}{?size} {size}{?}",
      "keyWidth": 17
    },
    {
      "type": "custom",
      "format": "{#38;2;89;102;105}├─ {#38;2;138;156;170}󰻠 Hardware Information"
    },
    {
      "type": "cpu",
      "key": "{#38;2;77;74;72}│ {#38;2;199;171;138}──[ 󰻠 CPU ",
      "format": "{name}",
      "keyWidth": 17
    },
    {
      "type": "gpu",
      "key": "{#38;2;77;74;72}│ {#38;2;183;134;139}──[ 󰢮 GPU ",
      "format": "{name}",
      "keyWidth": 17
    },
    {
      "type": "memory",
      "key": "{#38;2;77;74;72}│ {#38;2;174;177;153}──[ 󰍛 Memory ",
      "format": "{used} / {total} ──[{percentage}]",
      "keyWidth": 17
    },
        {
      "type": "disk",
      "key": "{#38;2;77;74;72}│ {#38;2;176;172;175}──[ 󰟒 Home ",
      "folders": "/home",
      "format": "{size-used} | {size-total} ──[{size-percentage}] ",
      "keyWidth": 17
    },
    {
      "type": "disk",
      "key": "{#38;2;77;74;72}│ {#38;2;199;171;138}──[ 󰋊 Root ",
      "folders": "/",
      "format": "{size-used} | {size-total} ──[{size-percentage}] ",
      "keyWidth": 17
    },
    {
      "type": "disk",
      "key": "{#38;2;77;74;72}│ {#38;2;149;177;182}──[ 󰉋 Storage ",
      "folders": "/mnt/Storages",
      "format": "{size-used} | {size-total} ──[{size-percentage}] ",
      "keyWidth": 17
    },
    {
      "type": "colors",
      "key": "{#38;2;77;74;72}│ {#38;2;149;177;182}",
      "keyWidth": 17,
      "paddingLeft": 0,
      "symbol": "square"
    },
    {
      "type": "custom",
      "format": "{#38;2;89;102;105}└──────────────────────────────────────────────┘"
    },
    {
      "type": "break"
    }
  ]
}
