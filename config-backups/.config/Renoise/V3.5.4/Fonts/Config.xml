<?xml version="1.0" encoding="UTF-8"?>
<!--
  User font overrides for Renoise.
-->
<FontEngine doc_version="0">
  <Standard>
    <Size>10,11</Size>
    <FileName>/usr/share/fonts/TTF/JetBrainsMono-Bold.ttf</FileName>
    <AntiAlias>YES</AntiAlias>
  </Standard>
  <StandardBig>
    <Size>12,12</Size>
    <FileName>/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf</FileName>
    <AntiAlias>YES</AntiAlias>
  </StandardBig>
  <Bold>
    <Size>10,10</Size>
    <FileName>/usr/share/fonts/TTF/JetBrainsMono-SemiBold.ttf</FileName>
    <AntiAlias>YES</AntiAlias>
  </Bold>
  <Italic>
    <Size>10,10</Size>
    <FileName>/usr/share/fonts/TTF/JetBrainsMono-Italic.ttf</FileName>
    <AntiAlias>YES</AntiAlias>
  </Italic>
  <Monospaced>
    <Size>10,10</Size>
    <FileName>/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf</FileName>
    <AntiAlias>YES</AntiAlias>
  </Monospaced>
  <Code>
    <Size>11,11</Size>
    <FileName>/usr/share/fonts/TTF/JetBrainsMono-Regular.ttf</FileName>
    <AntiAlias>YES</AntiAlias>
  </Code>
</FontEngine>
