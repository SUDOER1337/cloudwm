#!/bin/sh
# ~/.xinitrc - auto-start apps and settings for fjordwm
set -eu

# Enter a dedicated DBus session before starting any daemons.
if command -v dbus-run-session >/dev/null 2>&1 \
  && [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] \
  && [ "${_IN_DBUS_RUN_SESSION:-0}" = "0" ]; then
  export _IN_DBUS_RUN_SESSION=1
  exec dbus-run-session -- "$0"
fi

# Small helper: start program only if it's installed and not already running
run_once() {
  [ "$#" -gt 0 ] || return 0
  cmd="$1"
  cmd_name="${cmd##*/}"

  if [ "${cmd#*/}" != "$cmd" ]; then
    [ -x "$cmd" ] || return 0
  else
    command -v "$cmd" >/dev/null 2>&1 || return 0
  fi

  pgrep -x "$cmd_name" >/dev/null 2>&1 && return 0
  "$@" &
}

# --- DBus session (IMPORTANT) ---
# Fallback for systems without dbus-run-session.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] \
  && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# --- Environment ---
#
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=fjordwm
export XDG_SESSION_DESKTOP=fjordwm
export WM_NICKNAME=fjordwm
export XDG_MENU_PREFIX=arch-

export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
# Keep XKB on a single layout so fcitx5 owns EN/TH switching.
command -v setxkbmap >/dev/null 2>&1 && setxkbmap -layout us -option ""
fcitx5 -dr &

export QT_QPA_PLATFORMTHEME=qt5ct
export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24

# Make X11/session vars visible to systemd --user and DBus-activated services
# (needed for portal backends like xdg-desktop-portal-gtk).
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment DISPLAY XAUTHORITY \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY XAUTHORITY \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
fi

# KDE vars are usually unnecessary unless you specifically need KDE integration.
# If you keep them, it can confuse some apps into thinking you're in KDE.
# export KDE_FULL_SESSION=true
# export KDE_SESSION_VERSION=5

# --- KWallet (KDE wallet daemon) ---
if command -v kwalletd6 >/dev/null 2>&1; then
  run_once kwalletd6
elif command -v kwalletd5 >/dev/null 2>&1; then
  run_once kwalletd5
fi

# --- X resources ---
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# --- Display / power ---
command -v xrandr >/dev/null 2>&1 && xrandr -r 120 || true
if command -v xset >/dev/null 2>&1; then
  xset s off
  xset s noblank
  # xset -dpms  # uncomment if you truly want DPMS off
fi

# --- Audio ---
command -v pactl >/dev/null 2>&1 && pactl set-sink-volume @DEFAULT_SINK@ 100% || true

# --- Polkit agent (pick ONE) ---
# KDE agent:
run_once /usr/lib/polkit-kde-authentication-agent-1
# Alternative (GNOME):
# run_once /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# --- Portals (usually not needed on pure X11 WMs; can cause oddities) ---
# Prefer DBus/systemd activation. Set START_XDG_PORTALS=1 to force manual start.
if [ "${START_XDG_PORTALS:-0}" = "1" ]; then
  run_once /usr/lib/xdg-desktop-portal
  run_once /usr/lib/xdg-desktop-portal-gtk
fi

# --- Background services ---
run_once udiskie
run_once kdeconnectd
run_once nm-applet
# run_once blueman-applet

# Your custom stuff (start once)
[ -x "$HOME/fjordwm/scripts/autolock.sh" ] && run_once "$HOME/cloudwm/scripts/autolock.sh"
[ -x /opt/Synergy/synergy-service ] && run_once /opt/Synergy/synergy-service

# --- Tray/UX apps ---
run_once greenclip daemon
run_once flameshot
run_once dunst
run_once stretchly
run_once discord

# MPD
run_once mpd
( sleep 2; mpd-mpris >> "$HOME/.local/share/mpd-mpris.log" 2>&1 ) &
# Compositor
run_once picom

# Screen temperature
run_once redshift -v

# Status bar
run_once slstatus

# Extra
run_once fantech-driver preset

# Wallpaper
command -v feh >/dev/null 2>&1 && feh --bg-scale "$HOME/fjordwm/wallpapers/forest1.jpg" || true

# Give background daemons a moment (optional; usually not needed)
# sleep 1

# --- Start WM ---
[ -x "$HOME/.local/bin/fjordwm" ] && exec "$HOME/.local/bin/cloudwm"
exec fjordwm
