(defpoll workspaces_markup :interval "1s" `"$HOME/fjordwm/eww/scripts/workspaces.sh"`)
(defpoll media_label :interval "2s" `"$HOME/fjordwm/eww/scripts/media.sh" label`)
(defpoll updates_label :interval "10m" `"$HOME/fjordwm/eww/scripts/updates.sh" label`)
(defpoll network_label :interval "10s" `"$HOME/fjordwm/eww/scripts/network.sh" label`)
(defpoll volume_label :interval "2s" `"$HOME/fjordwm/eww/scripts/audio.sh" label`)
(defpoll volume_value :interval "2s" `"$HOME/fjordwm/eww/scripts/audio.sh" value`)
(defpoll brightness_label :interval "10s" `"$HOME/fjordwm/eww/scripts/brightness.sh" label`)
(defpoll brightness_value :interval "10s" `"$HOME/fjordwm/eww/scripts/brightness.sh" value`)
(defpoll battery_label :interval "30s" `"$HOME/fjordwm/eww/scripts/battery.sh"`)
(defpoll clock_label :interval "10s" `"$HOME/fjordwm/eww/scripts/clock.sh"`)
(defpoll notifications_label :interval "5s" `"$HOME/fjordwm/eww/scripts/session-state.sh" notifications-label`)
(defpoll idle_lock_label :interval "5s" `"$HOME/fjordwm/eww/scripts/session-state.sh" idle-label`)

(defwidget chip-button [class text onclick]
  (button :class class
          :onclick onclick
    (box :class "chip-content"
         :halign "center"
         :valign "center"
      (label :class "chip-text" :text text))))

(defwidget icon-action [class title text onclick]
  (button :class class
          :onclick onclick
    (box :orientation "vertical"
         :spacing 4
      (label :class "action-title" :text title)
      (label :class "action-value" :text text))))

(defwidget metric-card [title value]
  (box :class "metric-card"
       :orientation "vertical"
       :spacing 4
    (label :class "metric-card-title" :text title)
    (label :class "metric-card-value" :text value)))

(defwidget panel-row [title value onclick]
  (button :class "panel-row"
          :onclick onclick
    (box :orientation "horizontal"
         :halign "fill"
         :hexpand true
      (label :class "panel-row-title" :hexpand true :xalign 0 :text title)
      (label :class "panel-row-value" :xalign 1 :text value))))

(defwidget slider-card [title value label onchange]
  (box :class "slider-card"
       :orientation "vertical"
       :spacing 10
    (box :orientation "horizontal"
         :spacing 8
      (label :class "slider-title" :hexpand true :xalign 0 :text title)
      (label :class "slider-value" :xalign 1 :text label))
    (scale :class "slider"
           :orientation "horizontal"
           :min 0
           :max 100
           :value value
           :onchange onchange)))

(defwidget bar-content []
  (centerbox :class "bar-shell"
    (box :class "bar-group left"
         :spacing 10
      (chip-button :class "chip launcher"
                   :text ""
                   :onclick "$HOME/fjordwm/rofi/runner/runner.sh")
      (box :class "chip workspaces"
           :orientation "horizontal"
        (literal :content workspaces_markup)))
    (box :class "bar-group center"
         :hexpand true
         :halign "center"
      (chip-button :class "chip media"
                   :text media_label
                   :onclick "$HOME/fjordwm/rofi/media/media.sh"))
    (box :class "bar-group right"
         :spacing 6
      (chip-button :class "chip updates"
                   :text updates_label
                   :onclick "$HOME/fjordwm/eww/scripts/updates.sh run")
      (chip-button :class "chip network"
                   :text network_label
                   :onclick "$HOME/fjordwm/eww/scripts/network.sh open")
      (chip-button :class "chip audio"
                   :text volume_label
                   :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh control-panel")
      (chip-button :class "chip brightness"
                   :text brightness_label
                   :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh control-panel")
      (chip-button :class "chip battery"
                   :text battery_label
                   :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh control-panel")
      (chip-button :class "chip clock"
                   :text clock_label
                   :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh control-panel")
      (chip-button :class "chip control-toggle"
                   :text "󰕮"
                   :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh control-panel")
      (chip-button :class "chip power-toggle"
                   :text ""
                   :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh power-panel"))))

(defwidget control-panel-content []
  (box :class "panel control-panel"
       :orientation "vertical"
       :spacing 20
    (box :class "panel-header"
         :orientation "horizontal"
         :spacing 12
      (box :orientation "vertical"
           :hexpand true
           :spacing 4
        (label :class "panel-eyebrow" :text "Quick Control")
        (label :class "panel-title" :text "Fjordwl session controls"))
      (button :class "panel-close"
              :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh control-panel"
        (label :text "󰅖")))
    (box :class "panel-grid"
         :orientation "horizontal"
         :spacing 12
      (metric-card :title "Network" :value network_label)
      (metric-card :title "Updates" :value updates_label))
    (slider-card :title "Volume"
                 :value volume_value
                 :label volume_label
                 :onchange "$HOME/fjordwm/eww/scripts/audio.sh set {}")
    (box :class "panel-actions"
         :orientation "horizontal"
         :spacing 8
      (chip-button :class "chip panel-chip"
                   :text "󰝟 Mute"
                   :onclick "$HOME/fjordwm/eww/scripts/audio.sh toggle")
      (chip-button :class "chip panel-chip"
                   :text "󰐎 Media"
                   :onclick "$HOME/fjordwm/rofi/media/media.sh")
      (chip-button :class "chip panel-chip"
                   :text " Mixer"
                   :onclick "$HOME/fjordwm/eww/scripts/audio.sh open"))
    (slider-card :title "Brightness"
                 :value brightness_value
                 :label brightness_label
                 :onchange "$HOME/fjordwm/eww/scripts/brightness.sh set {}")
    (box :class "panel-actions"
         :orientation "horizontal"
         :spacing 8
      (chip-button :class "chip panel-chip"
                   :text "󰃠 Brightness"
                   :onclick "$HOME/fjordwm/rofi/brightness/brightness.sh")
      (chip-button :class "chip panel-chip"
                   :text "󰸉 Wallpaper"
                   :onclick "$HOME/fjordwm/rofi/wallpaper/wallpaper.sh menu")
      (chip-button :class "chip panel-chip"
                   :text "󰹑 Network"
                   :onclick "$HOME/fjordwm/eww/scripts/network.sh open"))
    (panel-row :title "Notifications"
               :value notifications_label
               :onclick "$HOME/fjordwm/eww/scripts/session-state.sh toggle-notifications")
    (panel-row :title "Idle lock"
               :value idle_lock_label
               :onclick "$HOME/fjordwm/eww/scripts/session-state.sh toggle-idle")
    (box :class "panel-actions"
         :orientation "horizontal"
         :spacing 8
      (chip-button :class "chip panel-chip"
                   :text "󰚰 Update"
                   :onclick "$HOME/fjordwm/eww/scripts/updates.sh run")
      (chip-button :class "chip panel-chip"
                   :text "󰄄 Control Center"
                   :onclick "$HOME/fjordwm/rofi/controlcenter/controlcenter.sh")
      (chip-button :class "chip panel-chip"
                   :text " Windows"
                   :onclick "$HOME/fjordwm/rofi/windows/windows.sh"))))

(defwidget power-panel-content []
  (box :class "panel power-panel"
       :orientation "vertical"
       :spacing 18
    (box :class "panel-header"
         :orientation "horizontal"
         :spacing 12
      (box :orientation "vertical"
           :hexpand true
           :spacing 4
        (label :class "panel-eyebrow" :text "Session")
        (label :class "panel-title" :text "Power actions"))
      (button :class "panel-close"
              :onclick "$HOME/fjordwm/eww/scripts/toggle-panel.sh power-panel"
        (label :text "󰅖")))
    (box :class "power-grid"
         :orientation "vertical"
         :spacing 10
      (icon-action :class "power-action"
                   :title "Lock"
                   :text " Secure the session"
                   :onclick "$HOME/fjordwm/eww/scripts/power.sh lock")
      (icon-action :class "power-action"
                   :title "Logout"
                   :text "󰗽 End fjordwl"
                   :onclick "$HOME/fjordwm/eww/scripts/power.sh logout")
      (icon-action :class "power-action"
                   :title "Suspend"
                   :text "󰒲 Sleep now"
                   :onclick "$HOME/fjordwm/eww/scripts/power.sh suspend")
      (icon-action :class "power-action"
                   :title "Reboot"
                   :text " Restart system"
                   :onclick "$HOME/fjordwm/eww/scripts/power.sh reboot")
      (icon-action :class "power-action danger"
                   :title "Shutdown"
                   :text "⏻ Power off"
                   :onclick "$HOME/fjordwm/eww/scripts/power.sh shutdown"))))

(defwindow bar
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "38px"
                      :anchor "top center")
  :stacking "bg"
  :focusable false
  :exclusive true
  (bar-content))

(defwindow control-panel
  :geometry (geometry :x "10px"
                      :y "60px"
                      :width "360px"
                      :height "476px"
                      :anchor "top right")
  :stacking "fg"
  :focusable true
  (control-panel-content))

(defwindow power-panel
  :geometry (geometry :x "10px"
                      :y "60px"
                      :width "360px"
                      :height "336px"
                      :anchor "top right")
  :stacking "fg"
  :focusable true
  (power-panel-content))
