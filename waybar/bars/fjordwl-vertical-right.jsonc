{
  "layer": "top",
  "position": "right",
  "margin": "0 0 0 0",
  "reload_style_on_change": true,

  "modules-left": [
    "custom/launcher",
    "clock",
    "dwl/tags",
    "custom/windows",
    "custom/media",
    "group/system"
  ],

  "modules-center": [],

  "modules-right": [
    "group/audio",
    "group/connection",
    "custom/updates",
    "tray",
    "battery",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "$HOME/fjordwm/rofi/runner/runner.sh",
    "tooltip": true,
    "tooltip-format": "App Launcher"
  },

  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "<tt><small>{:%A, %d %B %Y}\n\n{calendar}</small></tt>"
  },

  "dwl/tags": {
    "num-tags": 6,
    "tag-labels": ["󰖟", "", "", "", "", ""]
  },

  "custom/windows": {
    "exec": "$HOME/fjordwm/waybar/fjordwl-window-title.sh",
    "return-type": "json",
    "format": "{text}",
    "interval": 1,
    "hide-empty-text": false,
    "max-length": 26,
    "expand": false,
    "tooltip": true
  },

  "custom/media": {
    "exec": "$HOME/fjordwm/waybar/fjordwl-media-status.sh",
    "return-type": "json",
    "interval": 1,
    "max-length": 28,
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "$HOME/fjordwm/rofi/media/media.sh",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "group/system": {
    "orientation": "inherit",
    "modules": [
      "custom/cputemp",
      "cpu",
      "memory"
    ]
  },

  "custom/cputemp": {
    "format": "{}",
    "exec": "$HOME/fjordwm/waybar/bin/temp.sh",
    "interval": 5,
    "return-type": "json"
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 5,
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 10,
    "format": " {percentage}%",
    "on-click": "kitty -e btop"
  },

  "group/audio": {
    "orientation": "inherit",
    "modules": [
      "pulseaudio",
      "pulseaudio#mic"
    ]
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "headphones": "",
      "handsfree": "󰋌",
      "headset": "󰋌",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "{volume}% {icon} | {desc}",
    "on-click-right": "pavucontrol",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "smooth-scrolling-threshold": 1
  },

  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "󰍭",
    "tooltip-format": "{volume}% {format_source}",
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -2%",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +2%"
  },

  "group/connection": {
    "orientation": "inherit",
    "modules": [
      "custom/vpn",
      "custom/hotspot",
      "network",
      "network#speed"
    ]
  },

  "custom/vpn": {
    "format": "{}",
    "exec": "$HOME/fjordwm/waybar/bin/vpn",
    "return-type": "json",
    "interval": 5
  },

  "custom/hotspot": {
    "format": "{}",
    "exec": "$HOME/fjordwm/waybar/bin/hotspot",
    "return-type": "json",
    "interval": 5
  },

  "network": {
    "format": "{icon}",
    "format-icons": {
      "wifi": ["󰤨"],
      "ethernet": ["󰈀"],
      "disconnected": ["󰖪"]
    },
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": true,
    "tooltip-format": "{ifname} {ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "network#speed": {
    "format": "{bandwidthDownBits}",
    "rotate": 90,
    "interval": 5,
    "tooltip-format": "{ipaddr}"
  },

  "custom/updates": {
    "exec": "$HOME/fjordwm/waybar/bin/updatecheck.sh",
    "return-type": "json",
    "interval": 1000,
    "on-click": "$HOME/fjordwm/waybar/bin/updatecheck.sh --check",
    "on-click-right": "$HOME/fjordwm/waybar/bin/updatecheck.sh --update",
    "format": "{text}",
    "tooltip": true
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰂄",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}%"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "$HOME/fjordwm/rofi/powermenu/powermenu.sh",
    "tooltip": true,
    "tooltip-format": "Power Menu"
  }
}
